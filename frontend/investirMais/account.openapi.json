                  "$ref": "#/components/schemas/AdminPendingSummary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateProfileRequest": {
        "type": "object",
        "description": "Dados para atualização de perfil",
        "properties": {
          "name": {
            "type": "string",
            "description": "Apelido do usuário",
            "example": "Investidor",
            "maxLength": 100,
            "minLength": 2
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Novo endereço de e-mail",
            "example": "usuario@gmail.com",
            "maxLength": 254,
            "minLength": 0
          },
          "currentPassword": {
            "type": "string",
            "description": "Senha atual para confirmar a alteração do perfil",
            "maxLength": 4096,
            "minLength": 0
          }
        },
        "required": [
          "currentPassword",
          "email",
          "name"
        ]
      },
      "Response": {
        "type": "object",
        "description": "Resposta com dados do usuário",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador único (UUID)",
            "example": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d"
          },
          "name": {
            "type": "string",
            "description": "Apelido do usuário",
            "example": "Investidor"
          },
          "email": {
            "type": "string",
            "description": "E-mail cadastrado",
            "example": "usuario@gmail.com"
          },
          "role": {
            "type": "string",
            "description": "Perfil de acesso",
            "enum": [
              "ADMIN",
              "TEACHER",
              "STUDENT"
            ],
            "example": "STUDENT"
          },
          "emailVerified": {
            "type": "boolean",
            "description": "Status de validação do e-mail",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Data e hora do cadastro"
          }
        }
      },
      "UpdatePasswordRequest": {
        "type": "object",
        "description": "Dados para atualização de senha de usuário autenticado",
        "properties": {
          "currentPassword": {
            "type": "string",
            "description": "Senha atual do usuário",
            "example": "SenhaAntiga123",
            "maxLength": 4096,
            "minLength": 0
          },
          "newPassword": {
            "type": "string",
            "description": "Nova senha com minúscula, maiúscula, número e caractere especial",
            "example": "NovaSenhaSegura123!",
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^(?=[\\s\\S]*[a-z])(?=[\\s\\S]*[A-Z])(?=[\\s\\S]*[0-9])(?=[\\s\\S]*[\\x21-\\x2F\\x3A-\\x40\\x5B-\\x60\\x7B-\\x7E])[\\s\\S]*$"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "VerificationResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "signedIn": {
            "type": "boolean"
          }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "description": "Dados para redefinição de senha com token OTT",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token de verificação recebido por e-mail",
            "example": "123456",
            "maxLength": 64,
            "minLength": 0
          },
          "newPassword": {
            "type": "string",
            "description": "Nova senha com minúscula, maiúscula, número e caractere especial",
            "example": "NovaSenha123!",
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^(?=[\\s\\S]*[a-z])(?=[\\s\\S]*[A-Z])(?=[\\s\\S]*[0-9])(?=[\\s\\S]*[\\x21-\\x2F\\x3A-\\x40\\x5B-\\x60\\x7B-\\x7E])[\\s\\S]*$"
          }
        },
        "required": [
          "newPassword",
          "token"
        ]
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "description": "Dados para solicitação de recuperação de senha",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "E-mail do usuário que deseja redefinir a senha",
            "example": "usuario@gmail.com",
            "maxLength": 254,
            "minLength": 0
          }
        },
        "required": [
          "email"
        ]
      },
      "Request": {
        "type": "object",
        "description": "Dados para cadastro de um novo usuário",
        "properties": {
          "name": {
            "type": "string",
            "description": "Apelido do usuário",
            "example": "Investidor",
            "maxLength": 100,
            "minLength": 2
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Endereço de e-mail único",
            "example": "usuario@gmail.com",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "description": "Senha com minúscula, maiúscula, número e caractere especial",
            "example": "SenhaSegura123!",
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^(?=[\\s\\S]*[a-z])(?=[\\s\\S]*[A-Z])(?=[\\s\\S]*[0-9])(?=[\\s\\S]*[\\x21-\\x2F\\x3A-\\x40\\x5B-\\x60\\x7B-\\x7E])[\\s\\S]*$"
          },
          "role": {
            "type": "string",
            "description": "Perfil de acesso no sistema. O cadastro público aceita apenas STUDENT.",
            "enum": [
              "ADMIN",
              "TEACHER",
              "STUDENT"
            ],
            "example": "STUDENT"
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "ApplicationView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "userName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reviewReason": {
            "type": "string"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentView"
            }
          }
        }
      },
      "DocumentView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "mediaType": {
            "type": "string"
          }
        }
      },
      "Review": {
        "type": "object",
        "properties": {
          "approve": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          }
        },
        "required": [
          "approve",
          "reason"
        ]
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[a-z][a-z0-9-]{0,63}"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "label",
          "sections",
          "title"
        ]
      },
      "Release": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "publishedOn": {
            "type": "string",
            "format": "date"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            },
            "maxItems": 20,
            "minItems": 2
          }
        },
        "required": [
          "documents",
          "publishedOn"
        ]
      },
      "Section": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "content",
          "heading"
        ]
      },
      "AcceptanceRequest": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "accepted"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "currentVersion": {
            "type": "integer",
            "format": "int32"
          },
          "acceptanceRequired": {
            "type": "boolean"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateRoleRequest": {
        "type": "object",
        "description": "Requisição para alteração do perfil (role) do usuário pelo administrador",
        "properties": {
          "role": {
            "type": "string",
            "description": "Novo perfil do usuário (apenas TEACHER ou STUDENT)",
            "enum": [
              "ADMIN",
              "TEACHER",
              "STUDENT"
            ],
            "example": "TEACHER"
          }
        },
        "required": [
          "role"
        ]
      },
      "AuditResponse": {
        "type": "object",
        "description": "Registro de auditoria histórica de um usuário",
        "properties": {
          "revisionNumber": {
            "type": "integer",
            "format": "int32",
            "description": "Número sequencial da revisão",
            "example": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Data e hora exata da alteração"
          },
          "operation": {
            "type": "string",
            "description": "Tipo de operação: INSERT, UPDATE ou DELETE",
            "example": "UPDATE"
          },
          "before": {
            "$ref": "#/components/schemas/Response",
            "description": "Estado anterior do usuário (antes da alteração)"
          },
          "user": {
            "$ref": "#/components/schemas/Response",
            "description": "Estado do usuário no momento desta revisão"
          }
        }
      },
      "CourseStats": {
        "type": "object",
        "description": "Métricas de engajamento de um curso",
        "properties": {
          "courseId": {
            "type": "string",
            "format": "uuid",
            "description": "ID do curso"
          },
          "courseName": {
            "type": "string",
            "description": "Nome do curso"
          },
          "totalLessons": {
            "type": "integer",
            "format": "int64",
            "description": "Total de aulas neste curso"
          },
          "enrolledStudents": {
            "type": "integer",
            "format": "int64",
            "description": "Alunos matriculados no curso"
          },
          "lessonsWatched": {
            "type": "integer",
            "format": "int64",
            "description": "Aulas concluídas/assistidas pelos alunos"
          },
          "completionRate": {
            "type": "number",
            "format": "double",
            "description": "Taxa de conclusão do curso (%)",
            "example": 65
          }
        }
      },
      "Summary": {
        "type": "object",
        "description": "Estatísticas gerais consolidadas do professor no período",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "Data inicial do período de consulta (ISO-8601)",
            "example": "2026-05-08"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "Data final do período de consulta (ISO-8601)",
            "example": "2026-11-08"
          },
          "totalCourses": {
            "type": "integer",
            "format": "int64",
            "description": "Total de cursos criados pelo professor",
            "example": 4
          },
          "totalLessons": {
            "type": "integer",
            "format": "int64",
            "description": "Total de videoaulas publicadas",
            "example": 24
          },
          "totalStudents": {
            "type": "integer",
            "format": "int64",
            "description": "Total de alunos distintos matriculados no período",
            "example": 85
          },
          "totalLessonsWatched": {
            "type": "integer",
            "format": "int64",
            "description": "Total de aulas assistidas pelos alunos no período",
            "example": 310
          },
          "averageCompletionRate": {
            "type": "number",
            "format": "double",
            "description": "Taxa média geral de conclusão (%) no período",
            "example": 72.4
          },
          "courses": {
            "type": "array",
            "description": "Métricas detalhadas por curso no período",
            "items": {
              "$ref": "#/components/schemas/CourseStats"
            }
          }
        }
      },
      "PageMetadata": {
        "type": "object",
        "properties": {
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "number": {
            "type": "integer",
            "format": "int64"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "number",
          "size",
          "totalElements",
          "totalPages"
        ]
      },
      "PagedModelApplicationView": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApplicationView"
            }
          },
          "page": {
            "$ref": "#/components/schemas/PageMetadata"
          }
        },
        "required": [
          "content",
          "page"
        ]
      },
      "Acceptance": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AdminPendingSummary": {
        "type": "object",
        "properties": {
          "openReports": {
            "type": "integer",
            "format": "int64"
          },
          "pendingTeacherApplications": {
            "type": "integer",
            "format": "int64"
          },
          "recoverableAccounts": {
            "type": "integer",
            "format": "int64"
          },
          "expiringAccounts": {
            "type": "integer",
            "format": "int64"
          },
          "expiredAccounts": {
            "type": "integer",
            "format": "int64"
          },
          "nextRecoveryDeadline": {
            "type": "string",
            "format": "date-time"
          },
          "expiringWithinDays": {
            "type": "integer",
            "format": "int32"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeleteAccountRequest": {
        "type": "object",
        "description": "Confirmação para exclusão da própria conta",
        "properties": {
          "currentPassword": {
            "type": "string",
            "description": "Senha atual do usuário",
            "maxLength": 4096,
            "minLength": 0
          }
        },
        "required": [
          "currentPassword"
        ]
      }
    }
  }
