          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "Data final do período de consulta (ISO-8601)",
            "example": "2026-11-08"
          },
          "totalCourses": {
            "type": "integer",
            "format": "int64",
            "description": "Total de cursos criados pelo professor",
            "example": 4
          },
          "totalLessons": {
            "type": "integer",
            "format": "int64",
            "description": "Total de videoaulas publicadas",
            "example": 24
          },
          "totalStudents": {
            "type": "integer",
            "format": "int64",
            "description": "Total de alunos distintos matriculados no período",
            "example": 85
          },
          "totalLessonsWatched": {
            "type": "integer",
            "format": "int64",
            "description": "Total de aulas assistidas pelos alunos no período",
