              }
            }
          }
        }
      }
    },
    "/api/admin/pending": {
      "get": {
        "tags": [
          "admin-pending-controller"
        ],
        "summary": "Consultar pendências administrativas",
        "description": "Contadores de denúncias, candidaturas de contas ativas e prazos de recuperação. Não inclui dados pessoais.",
        "operationId": "getAdminPendingSummary",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
