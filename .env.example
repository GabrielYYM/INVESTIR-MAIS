# ==============================================================================
# INVESTIR MAIS - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha os valores de acordo com seu ambiente
# ==============================================================================

# Integrações / APIs Externas
BRAPI_TOKEN=seu_token_aqui

# Banco de Dados (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/investir_mais
DB_DRIVER=org.postgresql.Driver
DB_PLATFORM=postgresql
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_do_banco

# Configurações de E-mail (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_aplicativo_aqui
MAIL_AUTH=true
MAIL_STARTTLS=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret
CLOUDINARY_UPLOAD_PRESET=seu_upload_preset

# Configurações da Aplicação
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false
AUTH_RATE_LIMIT_CAPACITY=10
AUTH_RATE_LIMIT_PERIOD=1m
ACCOUNT_MAIL_RETRY_DELAY=30s
BRAPI_BASE_URL=https://brapi.dev/api
BRAPI_CONNECT_TIMEOUT=3s
BRAPI_READ_TIMEOUT=10s
