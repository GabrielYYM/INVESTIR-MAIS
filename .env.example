# ==============================================================================
# INVESTIR MAIS - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha os valores de acordo com seu ambiente
# ==============================================================================

# Banco de Dados (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/investir_mais
DB_DRIVER=org.postgresql.Driver
DB_PLATFORM=postgresql
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_do_banco

# Redis (backend local; em Docker, use o nome do serviço na mesma rede)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# Em produção, defina REDIS_PASSWORD e use REDIS_SSL_ENABLED=true.
REDIS_SSL_ENABLED=false

# Resend. Preencha a chave da API e o remetente verificado.
RESEND_API_KEY=
RESEND_FROM=

# Configurações da Aplicação
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false
AUTH_RATE_LIMIT_CAPACITY=10
AUTH_RATE_LIMIT_PERIOD=1m
AUTH_RATE_LIMIT_NAMESPACE=investir-mais:rate-limit
ACCOUNT_EMAIL_COOLDOWN=30s
ACCOUNT_MAIL_RETRY_DELAY=30s
